e\">{testimonial.author}</p>\n                  <p className=\"text-sm text-gray-500\">{testimonial.role}</p>\n                </div>\n              </div>\n\n              <Quote className=\"h-8 w-8 text-green-400/30 mb-4\" />\n              <p className=\"text-base leading-8 text-gray-300\">\"{testimonial.quote}\"</p>\n\n              <div className=\"mt-6 pt-4 border-t border-gray-700 flex items-center justify-between\">\n                <span className=\"text-xs font-bold text-green-400 bg-green-400/10 px-3 py-1.5 rounded-full\">\n                  {testimonial.metric}\n                </span>\n                <div className=\"h-1.5 w-16 rounded-full bg-green-400/20\">\n                  <div className=\"h-full w-[70%] rounded-full bg-gradient-to-r from-green-400 to-cyan-400\"></div>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\homepage\\TrainingPromo.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\homepage\\TrustStrip.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\homepage\\WebDevPromo.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\learner\\course-card.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\learner\\course-filters.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Sliders' is defined but never used.","line":3,"column":18,"nodeType":"Identifier","messageId":"unusedVar","endLine":3,"endColumn":25,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"Sliders"},"fix":{"range":[32,41],"text":""},"desc":"Remove unused variable \"Sliders\"."}]}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\r\n\r\nimport { Search, Sliders } from 'lucide-react';\r\n\r\ninterface CourseFiltersProps {\r\n  searchTerm: string;\r\n  onSearchChange: (term: string) => void;\r\n  levelFilter: string;\r\n  onLevelChange: (level: string) => void;\r\n  categoryFilter: string;\r\n  onCategoryChange: (category: string) => void;\r\n}\r\n\r\nconst levels = ['All Levels', 'Beginner', 'Intermediate', 'Advanced'];\r\nconst categories = ['All Categories', 'Security', 'Hacking', 'Networks', 'Compliance', 'Forensics', 'Administration'];\r\n\r\nexport default function CourseFilters({\r\n  searchTerm,\r\n  onSearchChange,\r\n  levelFilter,\r\n  onLevelChange,\r\n  categoryFilter,\r\n  onCategoryChange,\r\n}: CourseFiltersProps) {\r\n  return (\r\n    <div className=\"space-y-4 rounded-3xl border border-slate-800 bg-slate-900/50 p-6\">\r\n      {/* Search */}\r\n      <div className=\"space-y-2\">\r\n        <label className=\"text-sm font-medium text-slate-300\">Search Courses</label>\r\n        <div className=\"relative\">\r\n          <Search className=\"absolute left-3 top-3 size-5 text-slate-500\" />\r\n          <input\r\n            type=\"text\"\r\n            placeholder=\"Search by title, topic...\"\r\n            value={searchTerm}\r\n            onChange={(e) => onSearchChange(e.target.value)}\r\n            className=\"w-full rounded-2xl bg-slate-800 py-2 pl-10 pr-4 text-slate-100 placeholder-slate-500 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20\"\r\n          />\r\n        </div>\r\n      </div>\r\n\r\n      {/* Level Filter */}\r\n      <div className=\"space-y-2\">\r\n        <label className=\"text-sm font-medium text-slate-300\">Difficulty Level</label>\r\n        <div className=\"grid grid-cols-2 gap-2\">\r\n          {levels.map((level) => (\r\n            <button\r\n              key={level}\r\n              onClick={() => onLevelChange(level === 'All Levels' ? 'all' : level)}\r\n              className={`rounded-xl px-3 py-2 text-sm font-medium transition ${\r\n                (level === 'All Levels' ? levelFilter === 'all' : levelFilter === level)\r\n                  ? 'bg-emerald-500/20 text-emerald-300'\r\n                  : 'bg-slate-800 text-slate-400 hover:text-slate-200'\r\n              }`}\r\n            >\r\n              {level}\r\n            </button>\r\n          ))}\r\n        </div>\r\n      </div>\r\n\r\n      {/* Category Filter */}\r\n      <div className=\"space-y-2\">\r\n        <label className=\"text-sm font-medium text-slate-300\">Category</label>\r\n        <select\r\n          value={categoryFilter}\r\n          onChange={(e) => onCategoryChange(e.target.value)}\r\n          className=\"w-full rounded-2xl bg-slate-800 px-4 py-2 text-slate-100 transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/20\"\r\n        >\r\n          {categories.map((cat) => (\r\n            <option key={cat} value={cat === 'All Categories' ? '' : cat}>\r\n              {cat}\r\n            </option>\r\n          ))}\r\n        </select>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\learner\\lesson-player.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\CYBER\\cyber-bug-fixer\\components\\learner\\lesson-player.tsx:84:5\n  82 |\n  83 |   useEffect(() => {\n> 84 |     setActiveVideo(0);\n     |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  85 |     if (videoRef.current) videoRef.current.pause();\n  86 |   }, [lesson?._id]);\n  87 |","line":84,"column":5,"nodeType":null,"endLine":84,"endColumn":19}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"\"use client\";\n\nimport { useEffect, useRef, useState } from \"react\";\nimport { CheckCircle2, Download, FileText, Trophy } from \"lucide-react\";\n\ninterface VideoItem {\n  url?: string;\n  type?: string;\n  title?: string;\n  duration?: number;\n}\ninterface DownloadItem {\n  label?: string;\n  url?: string;\n  fileType?: string;\n}\ninterface QuizRef {\n  quizId?: string;\n}\ninterface AssignmentItem {\n  title?: string;\n  description?: string;\n  dueInDays?: number;\n  points?: number;\n}\n\ninterface Lesson {\n  _id?: string;\n  title: string;\n  description?: string;\n  notes?: string;\n  videos?: VideoItem[];\n  duration?: number;\n  downloads?: DownloadItem[];\n  quiz?: QuizRef;\n  assignment?: AssignmentItem;\n  discussionEnabled?: boolean;\n  completed?: boolean;\n}\n\ninterface Props {\n  lesson: Lesson | null;\n  isCompleted?: boolean;\n  locked?: boolean;\n  onEnded?: () => void;\n  onMarkComplete?: () => void;\n  quizTitle?: string | null;\n}\n\nfunction renderMarkdownSimple(text?: string) {\n  if (!text) return null;\n  // Minimal markdown: paragraphs + headings + code fences.\n  const blocks = text.split(/\\n{2,}/);\n  return blocks.map((block, i) => {\n    if (block.startsWith(\"### \")) {\n      return <h4 key={i} className=\"font-semibold text-white mt-3\">{block.replace(\"### \", \"\")}</h4>;\n    }\n    if (block.startsWith(\"## \")) {\n      return <h3 key={i} className=\"font-bold text-white mt-3\">{block.replace(\"## \", \"\")}</h3>;\n    }\n    if (block.startsWith(\"```\")) {\n      return (\n        <pre key={i} className=\"bg-slate-950 rounded-xl p-3 text-xs text-emerald-300 overflow-auto my-2\">\n          {block.replace(/```/g, \"\")}\n        </pre>\n      );\n    }\n    return <p key={i} className=\"text-slate-300 leading-relaxed\">{block}</p>;\n  });\n}\n\nexport default function LessonPlayer({\n  lesson,\n  isCompleted,\n  locked,\n  onEnded,\n  onMarkComplete,\n  quizTitle,\n}: Props) {\n  const videoRef = useRef<HTMLVideoElement | null>(null);\n  const [activeVideo, setActiveVideo] = useState(0);\n\n  useEffect(() => {\n    setActiveVideo(0);\n    if (videoRef.current) videoRef.current.pause();\n  }, [lesson?._id]);\n\n  if (locked) {\n    return (\n      <div className=\"w-full rounded-lg border border-amber-400/30 bg-amber-400/10 p-8 text-center text-amber-200\">\n        ≡ƒöÆ This lesson is locked. Complete the previous requirements to unlock it.\n      </div>\n    );\n  }\n\n  if (!lesson) {\n    return (\n      <div className=\"w-full rounded-lg border border-slate-800 bg-slate-900 p-8 text-center text-slate-400\">\n        Select a lesson to begin.\n      </div>\n    );\n  }\n\n  const video = lesson.videos?.[activeVideo] || lesson.videos?.[0];\n  const hasVideo = Boolean(video?.url);\n\n  return (\n    <div className=\"space-y-4\">\n      <div className=\"rounded-lg overflow-hidden border border-slate-800 bg-black\">\n        {hasVideo ? (\n          <video\n            ref={videoRef}\n            key={video?.url}\n            src={video?.url}\n            controls\n            className=\"w-full h-[360px] bg-black\"\n            onEnded={onEnded}\n          />\n        ) : (\n          <div className=\"p-10 text-center text-slate-400\">No video for this lesson. Read the notes below.</div>\n        )}\n      </div>\n\n      {lesson.videos && lesson.videos.length > 1 && (\n        <div className=\"flex flex-wrap gap-2\">\n          {lesson.videos.map((v, idx) => (\n            <button\n              key={idx}\n              onClick={() => setActiveVideo(idx)}\n              className={`rounded-full px-3 py-1 text-xs ${activeVideo === idx ? \"bg-emerald-500 text-slate-950\" : \"bg-slate-800 text-slate-300\"}`}\n            >\n              {v.title || `Video ${idx + 1}`}\n            </button>\n          ))}\n        </div>\n      )}\n\n      <div className=\"rounded-lg border border-slate-800 bg-slate-900 p-5\">\n        <div className=\"flex items-center justify-between mb-2\">\n          <h3 className=\"text-lg font-bold text-emerald-400\">{lesson.title}</h3>\n          {isCompleted ? (\n            <span className=\"flex items-center gap-1 text-sm text-emerald-300\"><CheckCircle2 size={16} /> Completed</span>\n          ) : (\n            <button\n              onClick={onMarkComplete}\n              className=\"rounded-full bg-emerald-500 px-4 py-1.5 text-sm font-semibold text-slate-950 hover:bg-emerald-400\"\n            >\n              Mark Complete\n            </button>\n          )}\n        </div>\n        {lesson.description && <p className=\"text-sm text-slate-400 mb-3\">{lesson.description}</p>}\n        <div className=\"space-y-2\">{renderMarkdownSimple(lesson.notes)}</div>\n      </div>\n\n      {lesson.downloads && lesson.downloads.length > 0 && (\n        <div className=\"rounded-lg border border-slate-800 bg-slate-900 p-5\">\n          <h4 className=\"flex items-center gap-2 font-semibold text-white mb-3\"><Download size={16} className=\"text-emerald-400\" /> Downloads</h4>\n          <div className=\"space-y-2\">\n            {lesson.downloads.map((d, i) => (\n              <a\n                key={i}\n                href={d.url}\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"flex items-center justify-between rounded-xl bg-slate-950 px-4 py-2 text-sm text-slate-200 hover:bg-slate-800\"\n              >\n                <span className=\"flex items-center gap-2\"><FileText size={14} className=\"text-emerald-400\" /> {d.label || \"File\"}</span>\n                <span className=\"text-xs uppercase text-slate-500\">{d.fileType || \"file\"}</span>\n              </a>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {quizTitle && (\n        <div className=\"rounded-lg border border-slate-800 bg-slate-900 p-5\">\n          <h4 className=\"flex items-center gap-2 font-semibold text-white mb-1\"><Trophy size={16} className=\"text-emerald-400\" /> Lesson Quiz</h4>\n          <p className=\"text-sm text-slate-400\">{quizTitle}</p>\n        </div>\n      )}\n\n      {lesson.assignment && (\n        <div className=\"rounded-lg border border-slate-800 bg-slate-900 p-5\">\n          <h4 className=\"font-semibold text-white mb-1\">Assignment: {lesson.assignment.title}</h4>\n          {lesson.assignment.description && <p className=\"text-sm text-slate-400\">{lesson.assignment.description}</p>}\n          <div className=\"mt-1 text-xs text-slate-500\">\n            {lesson.assignment.points ? `${lesson.assignment.points} pts` : \"\"}\n            {lesson.assignment.dueInDays ? ` ┬╖ due in ${lesson.assignment.dueInDays} days` : \"\"}\n          </div>\n        </div>\n      )}\n\n      {lesson.discussionEnabled && (\n        <div className=\"rounded-lg border border-slate-800 bg-slate-900 p-5 text-sm text-slate-400\">\n          ≡ƒÆ¼ Discussion enabled for this lesson.\n        </div>\n      )}\n    </div>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\learner\\logout-button.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\learner\\progress-bar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\learner\\sidebar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\mission-section.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\navbar-fixed.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\navbar-wrapper.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\navbar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\CYBER\\cyber-bug-fixer\\components\\operational\\ai-incident-intelligence.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'colors' is defined but never used.","line":7,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLi