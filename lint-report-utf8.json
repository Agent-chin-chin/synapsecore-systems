ring]);\r\n\r\n  function resetFilters() {\r\n    setActorId('');\r\n    setAction('');\r\n    setTargetType('');\r\n    setTargetId('');\r\n    setPage(1);\r\n  }\r\n\r\n  if (loading) return <div>Loading...</div>;\r\n  if (error) return <div className=\"text-red-600\">{error}</div>;\r\n  if (logs.length === 0) return <div>No audit logs found.</div>;\r\n\r\n  return (\r\n    <div>\r\n      <div className=\"mb-4 grid gap-3 md:grid-cols-5\">\r\n        <input\r\n          className=\"rounded border px-3 py-2\"\r\n          placeholder=\"Actor ID\"\r\n          value={actorId}\r\n          onChange={(e) => setActorId(e.target.value)}\r\n        />\r\n        <input\r\n          className=\"rounded border px-3 py-2\"\r\n          placeholder=\"Action\"\r\n          value={action}\r\n          onChange={(e) => setAction(e.target.value)}\r\n        />\r\n        <input\r\n          className=\"rounded border px-3 py-2\"\r\n          placeholder=\"Target Type\"\r\n          value={targetType}\r\n          onChange={(e) => setTargetType(e.target.value)}\r\n        />\r\n        <input\r\n          className=\"rounded border px-3 py-2\"\r\n          placeholder=\"Target ID\"\r\n          value={targetId}\r\n          onChange={(e) => setTargetId(e.target.value)}\r\n        />\r\n        <button\r\n          type=\"button\"\r\n          className=\"rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700\"\r\n          onClick={resetFilters}\r\n        >\r\n          Reset\r\n        </button>\r\n      </div>\r\n\r\n      <div className=\"overflow-x-auto\">\r\n        <table className=\"min-w-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700\">\r\n          <thead>\r\n            <tr>\r\n              <th className=\"px-4 py-2 border text-left\">Time</th>\r\n              <th className=\"px-4 py-2 border text-left\">Actor</th>\r\n              <th className=\"px-4 py-2 border text-left\">Action</th>\r\n              <th className=\"px-4 py-2 border